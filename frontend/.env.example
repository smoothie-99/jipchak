# =====================================================================
# 프론트엔드 환경변수 템플릿
# 실제 .env 는 .gitignore 처리. 운영 환경은 nginx 가 라우팅하므로
# 보통 프론트는 별도 .env 없이 같은 origin 의 /api, /ws 를 사용한다.
# =====================================================================

# REST API 베이스 URL (axios 설정용). 비워두면 같은 origin 사용.
VITE_API_BASE_URL=

# 카메라 WebSocket 경로 (AI 서버의 /ws/stream 엔드포인트).
# 보통 같은 origin 으로 접속 (nginx 또는 vite proxy 가 처리).
# 다른 호스트로 직접 붙고 싶을 때만 절대 URL 지정 (예: ws://localhost:8000/ws/stream).
VITE_WS_STREAM_PATH=/ws/stream

# 관리자 페이지 진입 비밀번호.
# 주의: 클라이언트 번들에 그대로 들어가는 임시 보호 수단이다.
# 운영 단계에서는 백엔드 인증으로 교체해야 한다. (2단계 리팩토링 항목)
VITE_ADMIN_PASSWORD=
