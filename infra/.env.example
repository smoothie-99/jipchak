# =====================================================================
# 인프라 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 있으므로 커밋되지 않습니다.
#
# 보안 원칙: 이 파일은 Git 에 올라가므로 실제 값(포트/경로/비밀번호)을
# 직접 박지 말 것. 주석으로 예시만 표기하고 값은 비워둔다.
# =====================================================================

# --- Database (MySQL) ---
# 프로덕션에서는 root 대신 별도 계정 사용 권장. 강한 비밀번호 필수.
DB_HOST=db-jipchak
DB_USERNAME=
DB_PASSWORD=
# 예: 3306
DB_PORT=

# --- Redis ---
REDIS_HOST=redis-jipchak
# 예: 6379
REDIS_PORT=

# --- 서비스 포트 매핑 (호스트 측 포트) ---
# 모두 nginx upstream 으로만 사용되므로 외부에 알릴 필요 없음.
# 예: BACKEND_PORT=8108, AI_PORT=8001, FRONTEND_PORT=3001
BACKEND_PORT=
AI_PORT=
FRONTEND_PORT=

# --- Jenkins ---
# 예: JENKINS_PORT=8081, JENKINS_AGENT_PORT=50001
JENKINS_PORT=
JENKINS_AGENT_PORT=

# --- Nginx ---
# 표준 포트(80/443) 외 값을 쓸 때만 필요.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- 영상 저장 ---
# 예: ./videos 또는 /srv/jipchak/videos
HOST_VIDEO_DIR=

# --- Spring Boot 멀티파트 한도 ---
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# --- Frontend 빌드 타임 변수 (Vite import.meta.env.*) ---
# 주의: 이 값들은 docker compose build 시점에 클라이언트 번들에 정적 삽입된다.
# 진짜 비밀은 여기에 넣지 말 것. 2단계에서 백엔드 인증으로 이전 예정.
VITE_ADMIN_PASSWORD=

# AI 서버 WS endpoint — 외부 (예: RunPod) 가리킬 때 절대 URL.
# 비워두면 default '/ws/stream' (EC2 nginx proxy 경유).
# 예: wss://<pod-id>-8000.proxy.runpod.net/ws/stream
VITE_WS_STREAM_PATH=
