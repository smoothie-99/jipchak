# ─── Python 캐시 ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# ─── 가상환경 ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ─── 에디터 / IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── 학습 / 모델 가중치 ────────────────────────────────────────────
# 모델 가중치(.pth, .ckpt)는 용량이 크므로 Git에서 제외
# 공유 필요 시 별도 스토리지(Google Drive, S3 등) 사용 권장
*.pth
*.ckpt
*.pt
*.pkl
*.h5

# ─── 데이터셋 ─────────────────────────────────────────────────────
# 이미지·어노테이션 데이터셋은 용량이 크므로 제외 (약 390MB+)
# 사용법: dataset/ 에 직접 데이터를 넣어서 사용
dataset/

# ─── 학습 로그 / 출력 결과 ────────────────────────────────────────
runs/
logs/
outputs/
examples/output/
*.log
*.csv

# ─── Jupyter Notebook 체크포인트 ──────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── 배포 / 빌드 ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ─── 환경 변수 / 비밀 키 ──────────────────────────────────────────
.env
*.env
secrets.yaml
secrets.yml

# ─── macOS ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
