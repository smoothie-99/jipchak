# Python 가상환경 / 캐시 — 컨테이너 안에서 새로 설치하므로 제외
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 녹화/실험 산출물 — runtime 에 컨테이너 안에서 생성
data/
recordings/
experiments/

# 개발 도구 / 에디터
.vscode/
.idea/
*.swp
.git/
.gitignore

# 환경변수 — 빌드에 박지 않음. 실행 시 -e 또는 --env-file 로 주입
.env
.env.local
.env.*.local

# 모델 가중치는 별도 전략 (volume mount 또는 별도 단계)
# - 로컬 빌드 검증에서는 기본 포함하려면 아래 주석 해제 유지
# - 운영용 슬림 이미지는 아래 주석 해제하여 제외
