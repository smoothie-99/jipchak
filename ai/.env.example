# =====================================================================
# ai/.env 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 있으므로 커밋되지 않습니다.
#
# 보안 원칙: 이 파일은 Git 에 올라가므로 실제 값(포트/경로/엔드포인트)을
# 직접 박지 말 것. 주석으로 예시만 표기하고 값은 비워둔다.
# =====================================================================

# --- FastAPI 서버 ---
APP_HOST=0.0.0.0
# 예: 8000
APP_PORT=

# --- Spring Boot Backend (같은 docker network 안에서는 컨테이너명 사용) ---
# 예: http://app-jipchak:8080
SPRING_API_BASE_URL=

# --- 영상 저장 디렉토리 (컨테이너 내부 경로) ---
# 예: /data/recordings
RECORDING_DIR=

# --- 영상 인코딩 설정 ---
VIDEO_FPS=30
VIDEO_CODEC=mp4v

# --- GR-ConvNet 체크포인트 (없으면 dummy 모드) ---
# 경로를 실제 모델 파일 위치로 변경하세요.
GRCONVNET_CHECKPOINT=trained-models/your-model/epoch_XX_iou_X.XX
GRASP_DEVICE=cpu

# --- Object Detection (SSDLite-MobileNetV3) ---
# true: Detection→Crop→GR-ConvNet per-object 추론
# false: 전체 이미지 GR-ConvNet (기존 방식)
DETECTION_ENABLED=true
DETECTION_THRESHOLD=0.35
# COCO label 88 = teddy bear (인형뽑기 인형)
DETECTION_TARGET_LABELS=88

# --- 로그 레벨 ---
LOG_LEVEL=INFO
