# =====================================================================
# backend/.env 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 있으므로 커밋되지 않습니다.
#
# 보안 원칙: 이 파일은 Git 에 올라가므로 실제 비밀값(DB 비번 등)을
# 직접 박지 말 것. 주석으로 예시만 표기하고 값은 비워둔다.
#
# 사용 시점:
#   - IDE/CLI 로 Spring Boot 단독 실행 (gradle bootRun, IntelliJ Run Configuration)
#   - 컨테이너 실행 시는 infra/.env 가 사용된다.
# =====================================================================

# --- Database (MySQL) ---
# docker-compose 로 db-jipchak 컨테이너가 떠 있고 포트 매핑되어 있다는 가정.
# 예: localhost
DB_HOST=
# 예: 3306
DB_PORT=
# 예: jipchak_db
DB_NAME=
# 운영에서는 root 대신 별도 계정 사용 권장. 강한 비밀번호 필수.
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
# 예: localhost
REDIS_HOST=
# 예: 6379
REDIS_PORT=

# --- Spring Boot ---
# 예: 8080
SERVER_PORT=
SPRING_APPLICATION_NAME=server

# --- JPA (로컬 개발 편의값. 운영 기본은 application.yml 의 안전값 사용) ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=true

# --- 멀티파트(영상 업로드) 한도 ---
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=50MB

# --- 영상 보관 정책 ---
# 디스크에 보관할 최대 영상 개수. 초과 시 가장 오래된 것부터 자동 삭제.
JIPCHAK_VIDEO_MAX_COUNT=50
# 예: videos (상대) 또는 /srv/jipchak/videos (절대)
JIPCHAK_VIDEO_BASE_DIR=
